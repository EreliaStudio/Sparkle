{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "erelia-sparkle",
  "version": "0.1.3",
  "port-version": 0,
  "description": "Sparkle C++23 static library",
  "homepage": "https://github.com/EreliaStudio/Sparkle",
  "license": "MIT",
  "supports": "windows",
  "dependencies": [
    "glew",
    "opengl",
    "stb",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "test-library": {
      "description": "Install reusable image comparison and Windows/OpenGL test utilities"
    }
  }
}
