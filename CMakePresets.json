{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_MODE": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "relWithDebInfo",
      "displayName": "RelWithDebInfo",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "testDebug",
      "displayName": "Tests (Debug)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SPARKLE_BUILD_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      }
    },
    {
      "name": "testRelease",
      "displayName": "Tests (Release)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SPARKLE_BUILD_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "relWithDebInfo",
      "configurePreset": "relWithDebInfo"
    },
    {
      "name": "testDebug",
      "configurePreset": "testDebug",
      "targets": [
        "SparkleTestSuite"
      ]
    },
    {
      "name": "testRelease",
      "configurePreset": "testRelease",
      "targets": [
        "SparkleTestSuite"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "testDebug",
      "configurePreset": "testDebug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "unit"
        }
      }
    },
    {
      "name": "testRelease",
      "configurePreset": "testRelease",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "unit"
        }
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "testDebug",
      "displayName": "Configure, build, and run Debug tests",
      "steps": [
        {
          "type": "configure",
          "name": "testDebug"
        },
        {
          "type": "build",
          "name": "testDebug"
        },
        {
          "type": "test",
          "name": "testDebug"
        }
      ]
    },
    {
      "name": "testRelease",
      "displayName": "Configure, build, and run Release tests",
      "steps": [
        {
          "type": "configure",
          "name": "testRelease"
        },
        {
          "type": "build",
          "name": "testRelease"
        },
        {
          "type": "test",
          "name": "testRelease"
        }
      ]
    }
  ]
}
